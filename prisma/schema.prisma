generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

/// The tenant: an OEM or molder that owns molds.
model Organisation {
  id                    String   @id @default(cuid())
  name                  String
  timezone              String   @default("Asia/Kolkata")
  currency              String   @default("INR")
  unitSystem            String   @default("metric") // metric | imperial
  numberFormat          String   @default("indian") // indian (lakh/crore) | international
  /// Days without a shot reading before an active mold is flagged overdue.
  readingOverdueDays    Int      @default(30)
  /// always | cross_company | never — when transfer requests need approval
  transferApproval      String   @default("cross_company")
  /// Shots allowed between the outbound and inbound handover readings before a dispute is raised
  transferShotTolerance Int      @default(50)
  /// Press compatibility rule settings (see src/lib/compat.pure.ts DEFAULT_RULES)
  compatRules           Json     @default("{}")
  /// Mark molds for re-qualification when custody moves to another site
  requalifyOnTransfer   Boolean  @default(true)
  /// Capacity planning defaults
  capacityHoursPerMonth Int      @default(600)
  defaultOeePct         Int      @default(75)
  refurbDowntimeDays    Int      @default(14)
  status                String   @default("active") // active | suspended
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  divisions      Division[]
  sites          Site[]
  partners       Partner[]
  memberships    Membership[]
  roles          Role[]
  invites        Invite[]
  assetTypes     AssetType[]
  assets         Asset[]
  audit          AuditEvent[]
  imports        ImportJob[]
  transfers      Transfer[]
  templates      MaintenanceTemplate[]
  plans          MaintenancePlan[]
  workOrders     WorkOrder[]
  notifications  Notification[]
  attachments    Attachment[]
  moldPresses    MoldPress[]
  evaluations    ConditionEvaluation[]
  qualifications Qualification[]
  parts          Part[]
  stockMoves     StockMove[]
  budgetItems    BudgetItem[]
  demand         ProductDemand[]
}

model Division {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  code      String       @default("")
  createdAt DateTime     @default(now())
  sites     Site[]

  @@unique([orgId, name])
}

/// A linked company in the organisation's network: supplier, molder, toolmaker, warehouse or customer.
model Partner {
  id           String       @id @default(cuid())
  orgId        String
  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  kind         String       @default("molder") // molder | toolmaker | warehouse | supplier | customer
  code         String       @default("")
  gstin        String       @default("")
  contactName  String       @default("")
  contactEmail String       @default("")
  contactPhone String       @default("")
  country      String       @default("IN")
  status       String       @default("active") // active | inactive
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sites           Site[]
  memberships     Membership[]
  invites         Invite[]
  ownedAssets     Asset[]      @relation("AssetOwner")
  custodyAssets   Asset[]      @relation("AssetCustodian")
  toolmakerAssets Asset[]      @relation("AssetToolmaker")
  transfersFrom   Transfer[]   @relation("TransferFromPartner")
  transfersTo     Transfer[]   @relation("TransferToPartner")
  workOrders      WorkOrder[]

  @@unique([orgId, name])
}

/// A physical place. partnerId null = the organisation's own site.
model Site {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partnerId  String?
  partner    Partner?     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  divisionId String?
  division   Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  name       String
  code       String       @default("")
  kind       String       @default("plant") // plant | warehouse | toolmaker | supplier
  address    String       @default("")
  city       String       @default("")
  state      String       @default("")
  country    String       @default("IN")
  postalCode String       @default("")
  timezone   String       @default("Asia/Kolkata")
  latitude   Float?
  longitude  Float?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  assets        Asset[]
  transfersFrom Transfer[] @relation("TransferFromSite")
  transfersTo   Transfer[] @relation("TransferToSite")
  stock         Stock[]

  @@unique([orgId, name])
}

// ─── Identity & access ──────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  firstName       String    @default("")
  lastName        String    @default("")
  phone           String    @default("")
  platformRole    String? // platform_operator
  status          String    @default("active") // active | suspended
  emailVerifiedAt DateTime?
  otpCode         String?
  otpExpiresAt    DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships    Membership[]
  passwordResets PasswordReset[]
  audit          AuditEvent[]
  readings       MeterReading[]
  docVersions    DocumentVersion[]
  notifications  Notification[]
  assignedWork   WorkOrder[]       @relation("WorkOrderAssignee")
  labor          WorkOrderLabor[]
}

/// A user's access to one organisation: one role plus a data scope.
model Membership {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// all | sites | divisions | partner
  scopeType String       @default("all")
  scopeIds  String[]     @default([])
  /// Set for supplier users: they only see molds in this partner's custody.
  partnerId String?
  partner   Partner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  status    String       @default("active") // active | suspended
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
}

model Role {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String? // built-in role key; null for custom roles
  name        String
  description String       @default("")
  /// { [module]: action[] }
  permissions Json         @default("{}")
  /// Supplier roles are always scoped to a partner and use the simplified navigation.
  isSupplier  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  invites     Invite[]

  @@unique([orgId, name])
}

model Invite {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  roleId      String
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType   String       @default("all")
  scopeIds    String[]     @default([])
  partnerId   String?
  partner     Partner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  token       String       @unique
  status      String       @default("pending") // pending | accepted | revoked
  invitedById String?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Append-only. A database trigger rejects UPDATE and DELETE (see migration).
model AuditEvent {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String       @default("")
  entityLabel String       @default("")
  before      Json?
  after       Json?
  reason      String       @default("")
  createdAt   DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
}

// ─── Assets ─────────────────────────────────────────────────────────────────

model AssetType {
  id               String       @id @default(cuid())
  orgId            String
  org              Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key              String
  name             String
  /// mold | press | equipment. Drives which standard fields and tabs are shown.
  kind             String       @default("equipment")
  description      String       @default("")
  numberPrefix     String       @default("")
  /// { components, cavities, products, meters, documents } booleans
  features         Json         @default("{}")
  /// Condition evaluation criteria: [{ key, label, weight }]; scores below the threshold raise a work order
  evalCriteria     Json         @default("[]")
  evalThreshold    Float        @default(3)
  evalIntervalDays Int          @default(180)
  /// Budget generation rules: { pmCostPerService, partsPerCavity, refurbCost, replacementCost }
  budgetRules      Json         @default("{}")
  archived         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  fields FieldDef[]
  assets Asset[]

  @@unique([orgId, key])
}

model FieldDef {
  id          String    @id @default(cuid())
  assetTypeId String
  assetType   AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String // text | number | date | boolean | picklist | formula
  unit        String    @default("")
  options     String[]  @default([])
  formula     String    @default("")
  required    Boolean   @default(false)
  section     String    @default("Additional")
  helpText    String    @default("")
  sortOrder   Int       @default(0)
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([assetTypeId, key])
}

model Asset {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetTypeId String
  assetType   AssetType    @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  number      String
  name        String
  /// active | in_transfer | in_maintenance | refurbishing | quarantined | retired | scrapped
  status      String       @default("active")
  qrToken     String       @unique

  // Ownership / custody / location / assignment (spec §3.2). null partner = the organisation itself.
  ownerPartnerId     String?
  ownerPartner       Partner? @relation("AssetOwner", fields: [ownerPartnerId], references: [id], onDelete: Restrict)
  custodianPartnerId String?
  custodianPartner   Partner? @relation("AssetCustodian", fields: [custodianPartnerId], references: [id], onDelete: Restrict)
  siteId             String
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  locationDetail     String   @default("")
  program            String   @default("")
  assignment         String   @default("")

  // Hierarchy: components belong to a parent asset.
  parentId      String?
  parent        Asset?  @relation("AssetComponents", fields: [parentId], references: [id], onDelete: SetNull)
  components    Asset[] @relation("AssetComponents")
  componentRole String  @default("") // insert | core | cavity block | slide | lifter | hot runner | other

  // Mold design (standard fields; shown for kind = mold)
  toolNumber       String @default("")
  designCavities   Int?
  designCycleTimeS Float?
  shotWeightG      Float?
  material         String @default("")
  lengthMm         Float?
  widthMm          Float?
  heightMm         Float?
  weightKg         Float?
  clampTonnageT    Float?
  hotRunnerZones   Int?
  coolingCircuits  Int?
  /// Mold: shut height, opening needed to eject, locating ring, sprue bush radius
  stackHeightMm    Float?
  openingStrokeMm  Float?
  locatingRingMm   Float?
  sprueRadiusMm    Float?
  /// Press capabilities (spec §4.2)
  tieBarHMm        Float?
  tieBarVMm        Float?
  platenWMm        Float?
  platenHMm        Float?
  minMoldHeightMm  Float?
  maxMoldHeightMm  Float?
  maxOpeningMm     Float?
  shotCapacityG    Float?
  nozzleRadiusMm   Float?
  maxMoldWeightKg  Float?

  // Life
  toolmakerPartnerId  String?
  toolmakerPartner    Partner?  @relation("AssetToolmaker", fields: [toolmakerPartnerId], references: [id], onDelete: SetNull)
  buildDate           DateTime?
  warrantyShots       Int?
  shotsBetweenRefurbs Int?
  refurbsAllowed      Int?
  refurbsDone         Int       @default(0)
  /// Lifetime shots and date at the last completed refurbishment work order
  lastRefurbShots     Int?
  lastRefurbDate      DateTime?
  endOfLifeShots      Int?
  capitalisationDate  DateTime?
  capitalValue        Decimal?  @db.Decimal(14, 2)
  costCentre          String    @default("")

  customValues          Json      @default("{}")
  notes                 String    @default("")
  /// Condition (latest approved evaluation) and qualification state
  conditionScore        Float?
  conditionDate         DateTime?
  nextEvaluationDate    DateTime?
  requalificationReason String    @default("")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  cavities       Cavity[]
  products       AssetProduct[]
  meters         Meter[]
  documents      Document[]
  transferItems  TransferItem[]
  plans          MaintenancePlan[]
  workOrders     WorkOrder[]
  pressesFor     MoldPress[]           @relation("MoldPressMold")
  moldsFor       MoldPress[]           @relation("MoldPressPress")
  evaluations    ConditionEvaluation[]
  qualifications Qualification[]       @relation("QualMold")
  qualifiedOn    Qualification[]       @relation("QualPress")
  partLinks      PartAsset[]
  budgetItems    BudgetItem[]

  @@unique([orgId, number])
  @@index([orgId, siteId])
  @@index([orgId, custodianPartnerId])
}

model Cavity {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  identifier    String
  status        String   @default("active") // active | blocked
  blockedReason String   @default("")
  createdAt     DateTime @default(now())

  @@unique([assetId, identifier])
}

model AssetProduct {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  partNumber   String
  partName     String   @default("")
  /// For family molds: how many cavities produce this part.
  cavitiesUsed Int?
  customer     String   @default("")
  createdAt    DateTime @default(now())

  @@unique([assetId, partNumber])
}

model Meter {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind          String    @default("shots") // shots | hours
  name          String    @default("Shot counter")
  unit          String    @default("shots")
  /// Lifetime total = last raw counter value + offset. Offset grows when a counter is reset or replaced.
  offset        Int       @default(0)
  lastRawValue  Int?
  lifetimeTotal Int       @default(0)
  lastReadingAt DateTime?
  createdAt     DateTime  @default(now())

  readings MeterReading[]

  @@unique([assetId, kind])
}

model MeterReading {
  id          String   @id @default(cuid())
  meterId     String
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  rawValue    Int
  lifetime    Int
  delta       Int
  readAt      DateTime
  source      String   @default("manual") // manual | import | handover | api
  isReset     Boolean  @default(false)
  resetReason String   @default("")
  note        String   @default("")
  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([meterId, readAt])
}

model Document {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("other") // drawing | trial_report | certificate | photo | qualification | manual | other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  filename     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String   @unique
  note         String   @default("")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
}

model ImportJob {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        String // assets | readings
  filename    String
  status      String       @default("validated") // validated | applied | failed
  rowCount    Int          @default(0)
  errorCount  Int          @default(0)
  /// Parsed, validated rows awaiting apply.
  payload     Json         @default("[]")
  errors      Json         @default("[]")
  createdById String?
  createdAt   DateTime     @default(now())
  appliedAt   DateTime?
}

// ─── Transfers (spec §4.1) ──────────────────────────────────────────────────

/// draft → requested → approved → in_transit → completed, or rejected / cancelled; disputed if a handover does not reconcile.
model Transfer {
  id               String       @id @default(cuid())
  orgId            String
  org              Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number           String
  status           String       @default("draft")
  reason           String       @default("production_move")
  fromSiteId       String
  fromSite         Site         @relation("TransferFromSite", fields: [fromSiteId], references: [id], onDelete: Restrict)
  fromPartnerId    String?
  fromPartner      Partner?     @relation("TransferFromPartner", fields: [fromPartnerId], references: [id], onDelete: Restrict)
  toSiteId         String
  toSite           Site         @relation("TransferToSite", fields: [toSiteId], references: [id], onDelete: Restrict)
  toPartnerId      String?
  toPartner        Partner?     @relation("TransferToPartner", fields: [toPartnerId], references: [id], onDelete: Restrict)
  toLocationDetail String       @default("")
  neededBy         DateTime?
  notes            String       @default("")
  requestedById    String?
  requestedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String       @default("")
  carrier          String       @default("")
  trackingNumber   String       @default("")
  vehicleNumber    String       @default("")
  ewayBillNumber   String       @default("")
  eta              DateTime?
  shippedAt        DateTime?
  shippedById      String?
  receivedAt       DateTime?
  receivedById     String?
  completedAt      DateTime?
  cancelledReason  String       @default("")
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items TransferItem[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model TransferItem {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  /// pending | shipped | accepted | disputed | resolved
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  handovers Handover[]
  disputes  Dispute[]

  @@unique([transferId, assetId])
}

model Handover {
  id            String       @id @default(cuid())
  itemId        String
  item          TransferItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  direction     String // outbound | inbound
  shotReading   Int?
  /// Lifetime total after recording shotReading (null when the asset has no counter)
  lifetimeShots Int?
  /// [{ key, label, ok, note }]
  checklist     Json         @default("[]")
  conditionOk   Boolean      @default(true)
  accessories   String       @default("")
  notes         String       @default("")
  tagVerified   Boolean      @default(false)
  byUserId      String?
  at            DateTime     @default(now())

  @@unique([itemId, direction])
}

model Dispute {
  id            String       @id @default(cuid())
  itemId        String
  item          TransferItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind          String // shot_mismatch | condition | missing_accessories | other
  detail        String
  outboundShots Int?
  inboundShots  Int?
  status        String       @default("open") // open | resolved
  resolution    String       @default("")
  resolvedById  String?
  resolvedAt    DateTime?
  workOrderId   String?
  createdAt     DateTime     @default(now())
}

// ─── Maintenance (spec §4.4) ────────────────────────────────────────────────

model MaintenanceTemplate {
  id             String       @id @default(cuid())
  orgId          String
  org            Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  /// preventive | inspection | refurbishment
  kind           String       @default("preventive")
  description    String       @default("")
  estimatedHours Float?
  /// [{ id, text, type: check|measure|photo, unit, min, max, required }]
  tasks          Json         @default("[]")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plans      MaintenancePlan[]
  workOrders WorkOrder[]

  @@unique([orgId, name])
}

/// A trigger on one asset: every N shots or every N days, warning at leadPct %.
model MaintenancePlan {
  id            String              @id @default(cuid())
  orgId         String
  org           Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  templateId    String
  template      MaintenanceTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  triggerType   String // shots | days
  interval      Int
  leadPct       Int                 @default(90)
  /// Counter and date the interval is measured from (reset when its work order completes)
  baselineShots Int                 @default(0)
  baselineDate  DateTime            @default(now())
  warnedAt      DateTime?
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())

  workOrders WorkOrder[]

  @@unique([assetId, templateId])
}

model WorkOrder {
  id                String               @id @default(cuid())
  orgId             String
  org               Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number            String
  assetId           String
  asset             Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  /// preventive | corrective | refurbishment | inspection | modification
  type              String
  title             String
  description       String               @default("")
  /// open | in_progress | on_hold | completed | cancelled
  status            String               @default("open")
  priority          String               @default("medium") // low | medium | high | urgent
  assignedUserId    String?
  assignedUser      User?                @relation("WorkOrderAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// Work done by a partner (e.g. the molder holding the mold)
  assignedPartnerId String?
  assignedPartner   Partner?             @relation(fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  planId            String?
  plan              MaintenancePlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  templateId        String?
  template          MaintenanceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// manual | trigger | checklist_failure | dispute | quarantine
  source            String               @default("manual")
  sourceId          String               @default("")
  scheduledDate     DateTime?
  dueDate           DateTime?
  /// For shot-triggered work: the counter value at which it falls due
  dueAtShots        Int?
  startedAt         DateTime?
  completedAt       DateTime?
  completedById     String?
  shotsAtCompletion Int?
  /// [{ id, text, type, unit, min, max, required, result: pass|fail|na|null, value, note }]
  checklist         Json                 @default("[]")
  passPct           Float?
  rootCause         String               @default("")
  resolution        String               @default("")
  externalCost      Decimal              @default(0) @db.Decimal(14, 2)
  clearsQuarantine  Boolean              @default(false)
  signedByName      String               @default("")
  signedAt          DateTime?
  cancelReason      String               @default("")
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  labor WorkOrderLabor[]
  parts WorkOrderPart[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([assetId, status])
}

model WorkOrderLabor {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workerName  String    @default("")
  hours       Float
  rate        Decimal   @default(0) @db.Decimal(10, 2)
  note        String    @default("")
  createdAt   DateTime  @default(now())
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partNumber  String    @default("")
  description String
  quantity    Float
  unitCost    Decimal   @default(0) @db.Decimal(14, 2)
  /// Set when issued from stock (a StockMove of kind "issue" records the deduction)
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)
  siteId      String?
  createdAt   DateTime  @default(now())
}

// ─── Cross-cutting ──────────────────────────────────────────────────────────

/// Files attached to handovers and work orders (asset documents use Document/DocumentVersion).
model Attachment {
  id           String       @id @default(cuid())
  orgId        String
  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerType    String // handover | work_order
  ownerId      String
  filename     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String       @unique
  uploadedById String?
  createdAt    DateTime     @default(now())

  @@index([ownerType, ownerId])
}

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String       @default("")
  link      String       @default("")
  /// Prevents repeating the same alert (e.g. "reading-overdue:<asset>:<date>")
  dedupeKey String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

// ─── Phase 3c: engineering & planning ───────────────────────────────────────

/// A mold–press pair. "approved" comes from a passed PQ; revoked pairs keep their history.
model MoldPress {
  id              String       @id @default(cuid())
  orgId           String
  org             Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  moldId          String
  mold            Asset        @relation("MoldPressMold", fields: [moldId], references: [id], onDelete: Cascade)
  pressId         String
  press           Asset        @relation("MoldPressPress", fields: [pressId], references: [id], onDelete: Cascade)
  /// approved | revoked
  status          String       @default("approved")
  qualificationId String?
  approvedById    String?
  approvedAt      DateTime     @default(now())
  revokedReason   String       @default("")
  /// Process settings proven at PQ (cycle time achieved etc.)
  notes           String       @default("")

  @@unique([moldId, pressId])
}

model ConditionEvaluation {
  id            String       @id @default(cuid())
  orgId         String
  org           Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// submitted | approved | rejected
  status        String       @default("submitted")
  /// [{ key, label, weight, score (1–5), note }]
  scores        Json
  score         Float
  notes         String       @default("")
  shots         Int?
  evaluatedById String?
  evaluatedAt   DateTime     @default(now())
  decidedById   String?
  decidedAt     DateTime?
  rejectReason  String       @default("")
  workOrderId   String?
  createdAt     DateTime     @default(now())

  @@index([assetId, evaluatedAt])
}

/// IQ → OQ → PQ for a mold, optionally on a specific press (PQ pass approves the pair).
model Qualification {
  id          String       @id @default(cuid())
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      String
  assetId     String
  asset       Asset        @relation("QualMold", fields: [assetId], references: [id], onDelete: Cascade)
  pressId     String?
  press       Asset?       @relation("QualPress", fields: [pressId], references: [id], onDelete: SetNull)
  siteId      String
  /// initial | requalification
  kind        String       @default("initial")
  reason      String       @default("")
  /// in_progress | passed | failed | cancelled
  status      String       @default("in_progress")
  createdById String?
  createdAt   DateTime     @default(now())
  closedAt    DateTime?

  stages QualificationStage[]

  @@unique([orgId, number])
}

model QualificationStage {
  id              String        @id @default(cuid())
  qualificationId String
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  /// IQ | OQ | PQ
  stage           String
  /// pending | in_progress | passed | failed
  status          String        @default("pending")
  ownerId         String?
  plannedDate     DateTime?
  actualDate      DateTime?
  result          String        @default("")
  workOrderId     String?
  approvedById    String?
  approvedAt      DateTime?

  @@unique([qualificationId, stage])
}

model Part {
  id            String       @id @default(cuid())
  orgId         String
  org           Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number        String
  name          String
  manufacturer  String       @default("")
  mfrPartNumber String       @default("")
  category      String       @default("")
  unit          String       @default("pcs")
  unitCost      Decimal      @default(0) @db.Decimal(14, 2)
  /// Defaults for new stock locations
  minQty        Float        @default(0)
  maxQty        Float        @default(0)
  reorderPoint  Float        @default(0)
  shelfLifeDays Int?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  stock   Stock[]
  moves   StockMove[]
  assets  PartAsset[]
  woParts WorkOrderPart[]

  @@unique([orgId, number])
}

model PartAsset {
  partId  String
  part    Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([partId, assetId])
}

/// Stock of one part at one site.
model Stock {
  id           String   @id @default(cuid())
  partId       String
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  bin          String   @default("")
  quantity     Float    @default(0)
  minQty       Float    @default(0)
  maxQty       Float    @default(0)
  reorderPoint Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([partId, siteId])
}

/// Stock ledger: every change to a stock quantity.
model StockMove {
  id           String       @id @default(cuid())
  orgId        String
  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partId       String
  part         Part         @relation(fields: [partId], references: [id], onDelete: Restrict)
  siteId       String
  /// receipt | issue | transfer_out | transfer_in | adjustment
  kind         String
  /// Signed: + into stock, − out of stock
  quantity     Float
  balanceAfter Float
  unitCost     Decimal      @default(0) @db.Decimal(14, 2)
  workOrderId  String?
  reference    String       @default("")
  note         String       @default("")
  expiresAt    DateTime?
  userId       String?
  createdAt    DateTime     @default(now())

  @@index([partId, createdAt])
}

model BudgetItem {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  year      Int
  /// pm | parts | refurbishment | replacement | other
  category  String
  amount    Decimal      @db.Decimal(14, 2)
  /// rule | manual
  source    String       @default("rule")
  note      String       @default("")
  updatedAt DateTime     @updatedAt

  @@unique([assetId, year, category])
  @@index([orgId, year])
}

/// Monthly demand per product (part number) for capacity planning.
model ProductDemand {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partNumber String
  /// First day of the month (UTC)
  month      DateTime
  quantity   Int
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, partNumber, month])
}
