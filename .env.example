DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/plant_metrics"
# Long random string used to sign session cookies (32+ characters)
AUTH_SECRET=""
# Public base URL, printed into QR tags and emailed links
APP_URL="http://localhost:3000"
# Where uploaded documents are stored (replace with object storage in production)
STORAGE_DIR="./storage"
# Bearer token for POST /api/cron/daily (maintenance triggers, overdue alerts). 16+ characters.
CRON_SECRET=""
# Optional: separate key for encrypting stored secrets (webhook and OIDC client secrets). Defaults to AUTH_SECRET.
DATA_KEY=""
# TEST ONLY — never set in production: allow http/private webhook targets and skip SSO domain DNS checks.
# WEBHOOK_ALLOW_HTTP=1
# WEBHOOK_ALLOW_PRIVATE=1
# SSO_SKIP_DOMAIN_VERIFICATION=1
